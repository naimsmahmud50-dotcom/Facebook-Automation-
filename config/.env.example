# ==============================================================================
# Facebook Automation Suite - Environment Configuration
# ==============================================================================
# IMPORTANT:
# 1. Duplicate this file and rename it to '.env'
# 2. Never commit your actual '.env' or credentials to public Git repositories!
# ==============================================================================

# Authentication Credentials (Leave empty if using cookie/session persistence)
FB_EMAIL=your_email_or_phone_here
FB_PASSWORD=your_secure_password_here

# 2-Factor Authentication Secret (Optional: Base32 TOTP key if 2FA is active)
FB_2FA_SECRET=

# Browser Execution Settings
HEADLESS=false
SLOW_MO_MS=150
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# Proxy Settings (Optional: http://user:pass@host:port or socks5://host:port)
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Session & Cookie Storage Path
SESSION_FILE_PATH=sessions/fb_session.json
